# Vercel 环境变量配置示例
# 将这些变量添加到 Vercel 项目设置中的环境变量部分

# ============================================
# 必需配置
# ============================================

# 数据库配置（必须使用外部数据库）
DB_TYPE=postgres

# 数据库连接 URL
# 方式 1（推荐）：不设置 DB_URL，让代码自动使用 Vercel 的 POSTGRES_URL
# 当你在 Vercel 中添加 Neon Postgres 时，POSTGRES_URL 会自动创建
# 代码会自动检测并使用它，无需手动配置

# 方式 2：手动设置数据库连接字符串
# 如果你使用其他数据库服务，取消注释并填写连接字符串：
# PostgreSQL 示例: postgresql://username:password@host:port/database
# MySQL 示例: mysql://username:password@host:port/database
# DB_URL=postgresql://username:password@host:port/database

DB_SSL=true

# 认证令牌（请使用强随机字符串，至少 32 字节）
# 生成方法：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_TOKEN=your-secure-admin-token-min-32-bytes
PROXY_TOKEN=your-secure-proxy-token-min-32-bytes
ACCOUNT_CREDENTIAL_SECRET=your-secure-credential-secret-min-32-bytes

# Node 环境
NODE_ENV=production

# ============================================
# OAuth 配置（可选）
# ============================================

# Claude OAuth
CLAUDE_CLIENT_ID=
CLAUDE_CLIENT_SECRET=

# Codex OAuth
CODEX_CLIENT_ID=

# Gemini CLI OAuth
GEMINI_CLI_CLIENT_ID=
GEMINI_CLI_CLIENT_SECRET=

# ============================================
# 通知配置（可选）
# ============================================

# Webhook 通知
WEBHOOK_URL=
WEBHOOK_ENABLED=true

# Bark 通知
BARK_URL=
BARK_ENABLED=true

# Server酱 通知
SERVERCHAN_KEY=
SERVERCHAN_ENABLED=true

# Telegram 通知
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_USE_SYSTEM_PROXY=false
TELEGRAM_MESSAGE_THREAD_ID=

# SMTP 邮件通知
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TO=

# 通知冷却时间（秒）
NOTIFY_COOLDOWN_SEC=300

# ============================================
# 代理配置（可选）
# ============================================

# 系统代理
SYSTEM_PROXY_URL=

# ============================================
# 定时任务配置（可选）
# ============================================

# 签到定时任务
CHECKIN_CRON=0 8 * * *
CHECKIN_SCHEDULE_MODE=cron
CHECKIN_INTERVAL_HOURS=6

# 余额刷新定时任务
BALANCE_REFRESH_CRON=0 * * * *

# 日志清理定时任务
LOG_CLEANUP_CRON=0 6 * * *
LOG_CLEANUP_USAGE_LOGS_ENABLED=true
LOG_CLEANUP_PROGRAM_LOGS_ENABLED=false
LOG_CLEANUP_RETENTION_DAYS=30

# ============================================
# 代理服务配置（可选）
# ============================================

# 代理日志保留天数
PROXY_LOG_RETENTION_DAYS=30
PROXY_LOG_RETENTION_PRUNE_INTERVAL_MINUTES=30

# 代理文件保留天数
PROXY_FILE_RETENTION_DAYS=30
PROXY_FILE_RETENTION_PRUNE_INTERVAL_MINUTES=60

# 代理超时配置
PROXY_FIRST_BYTE_TIMEOUT_SEC=0
PROXY_MAX_CHANNEL_ATTEMPTS=3

# 代理会话配置
PROXY_STICKY_SESSION_ENABLED=true
PROXY_STICKY_SESSION_TTL_MS=1800000
PROXY_SESSION_CHANNEL_CONCURRENCY_LIMIT=2
PROXY_SESSION_CHANNEL_QUEUE_WAIT_MS=1500
PROXY_SESSION_CHANNEL_LEASE_TTL_MS=90000
PROXY_SESSION_CHANNEL_LEASE_KEEPALIVE_MS=15000

# 代理错误关键词（逗号分隔）
PROXY_ERROR_KEYWORDS=
PROXY_EMPTY_CONTENT_FAIL=false

# ============================================
# 模型可用性探测（可选）
# ============================================

MODEL_AVAILABILITY_PROBE_ENABLED=false
MODEL_AVAILABILITY_PROBE_INTERVAL_MS=1800000
MODEL_AVAILABILITY_PROBE_TIMEOUT_MS=15000
MODEL_AVAILABILITY_PROBE_CONCURRENCY=1

# ============================================
# 路由配置（可选）
# ============================================

# 路由权重配置
BASE_WEIGHT_FACTOR=0.5
VALUE_SCORE_FACTOR=0.5
COST_WEIGHT=0.4
BALANCE_WEIGHT=0.3
USAGE_WEIGHT=0.3

# 路由失败冷却时间（秒）
TOKEN_ROUTER_FAILURE_COOLDOWN_MAX_SEC=2592000
TOKEN_ROUTER_CACHE_TTL_MS=1500

# 路由回退单位成本
ROUTING_FALLBACK_UNIT_COST=1

# ============================================
# 调试配置（可选）
# ============================================

# 代理调试跟踪
PROXY_DEBUG_TRACE_ENABLED=false
PROXY_DEBUG_CAPTURE_HEADERS=true
PROXY_DEBUG_CAPTURE_BODIES=false
PROXY_DEBUG_CAPTURE_STREAM_CHUNKS=false
PROXY_DEBUG_TARGET_SESSION_ID=
PROXY_DEBUG_TARGET_CLIENT_KIND=
PROXY_DEBUG_TARGET_MODEL=
PROXY_DEBUG_RETENTION_HOURS=24
PROXY_DEBUG_MAX_BODY_BYTES=262144

# ============================================
# 其他配置（可选）
# ============================================

# 服务器端口（Vercel 会自动处理）
PORT=4000

# 时区
TZ=Asia/Shanghai

# 管理员 IP 白名单（逗号分隔）
ADMIN_IP_ALLOWLIST=

# Codex 配置
CODEX_UPSTREAM_WEBSOCKET_ENABLED=false
CODEX_RESPONSES_WEBSOCKET_BETA=responses_websockets=2026-02-06

# 跨协议回退
DISABLE_CROSS_PROTOCOL_FALLBACK=false
RESPONSES_COMPACT_FALLBACK_TO_RESPONSES_ENABLED=false
